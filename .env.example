NODE_ENV=development
BOT_PORT=3000
BOT_MODE=polling
PUBLIC_BASE_URL=https://bot.example.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-32-byte-value

# admin is a temporary read-only integration for the current new-api routes.
# bridge is the preferred mode after the scoped Go integration routes exist.
NEW_API_INTEGRATION_MODE=admin
NEW_API_BASE_URL=https://api.example.com
# In official admin mode, these are the user-facing web destinations. The
# portal is used for payment and API Key management, which official new-api
# does not delegate to a Telegram Bot.
NEW_API_PORTAL_URL=https://supertoken.cc
NEW_API_PRICING_URL=https://supertoken.cc/pricing
NEW_API_DOCS_URL=https://docs.supertoken.cc
NEW_API_TOPUP_URL=https://supertoken.cc
NEW_API_ADMIN_PAT=
NEW_API_INTEGRATION_SECRET=
NEW_API_REQUEST_TIMEOUT_MS=4000

# Initial single-instance store. Docker mounts /app/data as a persistent volume.
# Use PostgreSQL only after moving to multiple instances or an independent worker.
DATABASE_URL=sqlite:./data/supertoken_bot.sqlite
BOT_ADMIN_TELEGRAM_IDS=
SUPPORT_CHAT_ID=
NOTIFICATION_INTERVAL_MS=900000
NOTIFICATION_DEFAULT_LOW_QUOTA_THRESHOLD=
BROADCAST_DELAY_MS=100
LOG_LEVEL=info
